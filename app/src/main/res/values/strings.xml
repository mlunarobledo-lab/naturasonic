    <string name="permission_microphone_title">Acceso al micrófono</string>
    <string name="permission_microphone_rationale">NaturaSonic necesita acceso al micrófono para capturar y amplificar el sonido ambiente a través de tus auriculares.</string>
    <string name="permission_bluetooth_title">Conexión Bluetooth</string>
    <string name="permission_bluetooth_rationale">NaturaSonic necesita Bluetooth para conectarse a tus auriculares y enviar el audio amplificado.</string>

    <string name="disclaimer_psap_title">Aviso importante</string>
    <string name="disclaimer_psap_body">Este producto no es un dispositivo médico. No está diseñado para diagnosticar, tratar ni prevenir pérdida auditiva. NaturaSonic es un producto de amplificación de sonido personal (PSAP) destinado a mejorar la experiencia auditiva en situaciones cotidianas. Si experimenta problemas de audición, consulte a un profesional de salud auditiva.</string>

    <string name="health_note_title">Nota de salud</string>
    <string name="health_note_body">Si experimenta molestias en sus oídos, dolor, zumbidos o cualquier síntoma auditivo, se sugiere la visita a un médico especialista otorrinolaringólogo o audiólogo.</string>
    <string name="health_note_find_specialist">Buscar especialista cercano</string>

    <string name="volume_warning_title">Precaución auditiva</string>
    <string name="volume_warning_body">Has alcanzado 1 hora de escucha continua. Para proteger tu audición, el volumen se ha reducido automáticamente a un nivel seguro (70 dB). Puedes pausar y retomar cuando desees.</string>

