<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="naturasonic.db" />
        <include domain="sharedpref" path="." />
        <include domain="file" path="datastore/" />
        <exclude domain="sharedpref" path="naturasonic_encrypted_prefs.xml" />
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs__.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="naturasonic.db" />
        <include domain="sharedpref" path="." />
        <include domain="file" path="datastore/" />
        <exclude domain="sharedpref" path="naturasonic_encrypted_prefs.xml" />
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs__.xml" />
    </device-transfer>
</data-extraction-rules>
